{
  "id": "ipad-touch-enhancer-main",
  "title": "iPadOS/iOS Safari Touch & UI Enhancer",
  "description": "Optimizes Foundry VTT for iPadOS/iOS Safari: Adds a draggable double-click/right-click mini-bar, fixes for window clipping and duplicate checkboxes, and more.",
  "version": "1.8.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13.351"
  },
  "relationships": {
    "requires": [
      {
        "id": "touch-vtt",
        "type": "module",
        "manifest": "https://github.com/Aioros/touch-vtt/releases/download/v2.3.13/module.json",
        "compatibility": {
          "minimum": "2.3.13",
          "verified": "2.3.13"
        }
      }
    ]
  },
  "authors": [
    {
      "name": "Frazhuz"
    }
  ],
  "esmodules": [
    "main.js"
  ],
  "styles": [
    "styles/touch-bar.css",
    "styles/token-hud.css",
    "styles/fix-windows.css",
    "styles/fix-region-legend.css",
    "styles/fix-checkboxes.css",
    "styles/small-changes.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ru",
      "name": "Русский",
      "path": "lang/ru.json"
    }
  ],
  "url": "https://github.com/Frazhuz/ipad-touch-enhancer",
  "manifest": "https://raw.githubusercontent.com/Frazhuz/ipad-touch-enhancer/main/module.json",
  "download": "https://github.com/Frazhuz/ipad-touch-enhancer/archive/refs/heads/main.zip"
}
